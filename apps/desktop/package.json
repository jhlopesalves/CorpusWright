{
  "name": "desktop",
  "private": true,
  "version": "0.1.0-alpha.8",
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:browser-test": "tsc && VITE_BROWSER_WORKFLOW=1 vite build",
    "test": "cd ../.. && node --experimental-strip-types --test apps/desktop/tests/*.test.ts",
    "test:dom": "vitest run",
    "test:browser": "npm run build:browser-test && start-test preview http://127.0.0.1:4173 'wdio run wdio.browser.conf.ts'",
    "test:native": "wdio run wdio.native.conf.ts",
    "check": "npm run build && npm run test && npm run test:dom && npm run check:theme-tokens && npm run check:theme-contrast && npm run check:style-ownership && npm run check:visual-contracts",
    "check:theme-tokens": "node scripts/check-theme-tokens.mjs",
    "check:theme-contrast": "node scripts/check-theme-contrast.mjs",
    "check:style-ownership": "node scripts/check-style-ownership.mjs",
    "check:visual-contracts": "node scripts/check-visual-contracts.mjs",
    "capture:overview-curation": "node scripts/capture-overview-curation.mjs",
    "capture:local-dossier": "node scripts/capture-local-corpus-dossier.mjs",
    "check:overview-rendering-recovery": "node scripts/capture-overview-curation.mjs --rendering-recovery",
    "check:overview-distribution-dispersion-cleanup": "node scripts/capture-overview-curation.mjs --distribution-dispersion-cleanup",
    "check:overview-legibility-and-dispersion-plane": "node scripts/capture-overview-curation.mjs --overview-legibility-and-dispersion-plane",
    "preview": "vite preview",
    "tauri": "tauri",
    "generate-types": "cd ../.. && cargo run -p corpuswright-core --example export_ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2",
    "katex": "^0.17.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@wdio/cli": "^9.29.1",
    "@wdio/local-runner": "^9.29.1",
    "@wdio/mocha-framework": "^9.29.1",
    "@wdio/spec-reporter": "^9.29.1",
    "@wdio/tauri-service": "^1.2.0",
    "happy-dom": "^20.10.6",
    "start-server-and-test": "^3.0.11",
    "typescript": "~5.6.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@wdio/native-utils": "^2.5.0",
    "serialize-javascript": "^7.0.5"
  }
}
